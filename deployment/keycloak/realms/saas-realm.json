{
  "realm": "saas",
  "keycloakVersion": "26.8.0",
  "accessTokenLifespan": 21600,
  "ssoSessionIdleTimeout": 21600,
  "enabled": true,
  "loginWithEmailAllowed": true,
  "organizationsEnabled": true,
  "clients": [
    {
      "clientId": "${KEYCLOAK_CLIENT_ID}",
      "name": "Multi-tenant tutorial app",
      "baseUrl": "${KEYCLOAK_HOME_URL}",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${KEYCLOAK_REDIRECT_URI}"
      ],
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": [
        "organization"
      ],
      "protocolMappers": [
        {
          "name": "MaaS tenant groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "maas_groups",
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "aggregate.attrs": "true"
          }
        },
        {
          "name": "MaaS organizations",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "maas_orgs_json",
            "claim.name": "https://redhat\\.com/maas/orgs",
            "jsonType.label": "JSON",
            "multivalued": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "MaaS audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "tenant-demo",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "MaaS access token purpose",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "token_use",
            "claim.value": "access",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "grid-tenant-1",
      "displayName": "Grid Tenant 1",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "hideOnLogin": true,
      "config": {
        "clientId": "saas-broker",
        "clientSecret": "${GRID_TENANT_1_BROKER_CLIENT_SECRET}",
        "clientAuthMethod": "client_secret_post",
        "issuer": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-1-idp",
        "authorizationUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-1-idp/protocol/openid-connect/auth",
        "tokenUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-1-idp/protocol/openid-connect/token",
        "userInfoUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-1-idp/protocol/openid-connect/userinfo",
        "logoutUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-1-idp/protocol/openid-connect/logout",
        "jwksUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-1-idp/protocol/openid-connect/certs",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "defaultScope": "openid email profile"
      }
    },
    {
      "alias": "grid-tenant-2",
      "displayName": "Grid Tenant 2",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "hideOnLogin": true,
      "config": {
        "clientId": "saas-broker",
        "clientSecret": "${GRID_TENANT_2_BROKER_CLIENT_SECRET}",
        "clientAuthMethod": "client_secret_post",
        "issuer": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-2-idp",
        "authorizationUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-2-idp/protocol/openid-connect/auth",
        "tokenUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-2-idp/protocol/openid-connect/token",
        "userInfoUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-2-idp/protocol/openid-connect/userinfo",
        "logoutUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-2-idp/protocol/openid-connect/logout",
        "jwksUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-2-idp/protocol/openid-connect/certs",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "defaultScope": "openid email profile"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "Grid Tenant 1 organization",
      "identityProviderAlias": "grid-tenant-1",
      "identityProviderMapper": "hardcoded-attribute-idp-mapper",
      "config": {
        "attribute": "maas_orgs_json",
        "attribute.value": "[{\"organization_id\":\"42c3e46f-2477-44d7-a85b-d3b43f6b31fa\",\"roles\":[\"users\"]}]",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "Grid Tenant 1 ai-grid-admins",
      "identityProviderAlias": "grid-tenant-1",
      "identityProviderMapper": "oidc-advanced-group-idp-mapper",
      "config": {
        "claims": "[{\"key\":\"groups\",\"value\":\"42c3e46f-2477-44d7-a85b-d3b43f6b31fa/ai-grid-admins\"}]",
        "are.claim.values.regex": "false",
        "group": "/42c3e46f-2477-44d7-a85b-d3b43f6b31fa/ai-grid-admins",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "Grid Tenant 1 ai-grid-users",
      "identityProviderAlias": "grid-tenant-1",
      "identityProviderMapper": "oidc-advanced-group-idp-mapper",
      "config": {
        "claims": "[{\"key\":\"groups\",\"value\":\"42c3e46f-2477-44d7-a85b-d3b43f6b31fa/ai-grid-users\"}]",
        "are.claim.values.regex": "false",
        "group": "/42c3e46f-2477-44d7-a85b-d3b43f6b31fa/ai-grid-users",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "Grid Tenant 2 organization",
      "identityProviderAlias": "grid-tenant-2",
      "identityProviderMapper": "hardcoded-attribute-idp-mapper",
      "config": {
        "attribute": "maas_orgs_json",
        "attribute.value": "[{\"organization_id\":\"53d4f57e-3588-55e8-b96c-4ec54a7c42fa\",\"roles\":[\"users\"]}]",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "Grid Tenant 2 ai-grid-users",
      "identityProviderAlias": "grid-tenant-2",
      "identityProviderMapper": "oidc-advanced-group-idp-mapper",
      "config": {
        "claims": "[{\"key\":\"groups\",\"value\":\"53d4f57e-3588-55e8-b96c-4ec54a7c42fa/ai-grid-users\"}]",
        "are.claim.values.regex": "false",
        "group": "/53d4f57e-3588-55e8-b96c-4ec54a7c42fa/ai-grid-users",
        "syncMode": "FORCE"
      }
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "id": "c20d0bd2-97fa-4e59-98df-5c9c873bfc66",
        "name": "saas-signing",
        "providerId": "java-keystore",
        "subComponents": {},
        "config": {
          "kid": [
            "c20d0bd2-97fa-4e59-98df-5c9c873bfc66"
          ],
          "priority": [
            "1000"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "RS256"
          ],
          "keyUse": [
            "SIG"
          ],
          "keystore": [
            "/opt/keycloak/data/saas/keystore.jks"
          ],
          "keystoreType": [
            "JKS"
          ],
          "keystorePassword": [
            "${KEYCLOAK_SIGNING_KEYSTORE_PASSWORD}"
          ],
          "keyAlias": [
            "saas-signing"
          ],
          "keyPassword": [
            "${KEYCLOAK_SIGNING_KEYSTORE_PASSWORD}"
          ]
        }
      }
    ],
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "id": "b5919e8a-046d-47e7-8a2c-f30f5ff12000",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "config-pieces-count": [
            "1"
          ],
          "config-piece-0": [
            "{\"unmanagedAttributePolicy\":\"ADMIN_EDIT\"}"
          ]
        }
      }
    ]
  },
  "organizations": [
    {
      "name": "Grid Tenant 1",
      "alias": "grid-tenant-1",
      "enabled": true,
      "domains": [
        {
          "name": "grid-tenant-1.test",
          "verified": false,
          "identityProviderAlias": "grid-tenant-1",
          "autoRedirect": true
        }
      ],
      "identityProviders": [
        {
          "alias": "grid-tenant-1",
          "organizationLinks": [
            {
              "autoMembership": true,
              "membershipType": "UNMANAGED"
            }
          ]
        }
      ]
    },
    {
      "name": "Grid Tenant 2",
      "alias": "grid-tenant-2",
      "enabled": true,
      "domains": [
        {
          "name": "grid-tenant-2.test",
          "verified": false,
          "identityProviderAlias": "grid-tenant-2",
          "autoRedirect": true
        }
      ],
      "identityProviders": [
        {
          "alias": "grid-tenant-2",
          "organizationLinks": [
            {
              "autoMembership": true,
              "membershipType": "UNMANAGED"
            }
          ]
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "42c3e46f-2477-44d7-a85b-d3b43f6b31fa",
      "subGroups": [
        {
          "name": "ai-grid-admins",
          "attributes": {
            "maas_groups": [
              "42c3e46f-2477-44d7-a85b-d3b43f6b31fa/ai-grid-admins"
            ]
          }
        },
        {
          "name": "ai-grid-users",
          "attributes": {
            "maas_groups": [
              "42c3e46f-2477-44d7-a85b-d3b43f6b31fa/ai-grid-users"
            ]
          }
        }
      ]
    },
    {
      "name": "53d4f57e-3588-55e8-b96c-4ec54a7c42fa",
      "subGroups": [
        {
          "name": "ai-grid-users",
          "attributes": {
            "maas_groups": [
              "53d4f57e-3588-55e8-b96c-4ec54a7c42fa/ai-grid-users"
            ]
          }
        }
      ]
    }
  ]
}
